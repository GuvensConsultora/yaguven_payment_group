<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_server_reconcile_selection" model="ir.actions.server">
        <field name="name">Conciliar selección</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    records.reconcile()
        </field>
    </record>

    <record id="action_server_unreconcile_selection" model="ir.actions.server">
        <field name="name">Desconciliar selección</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="binding_model_id" ref="account.model_account_move_line"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="state">code</field>
        <field name="code">
if records:
    records.remove_move_reconcile()
        </field>
    </record>

</odoo>
