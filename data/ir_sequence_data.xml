<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_account_payment_group_inbound" model="ir.sequence">
        <field name="name">Recibo de cobro</field>
        <field name="code">account.payment.group.inbound</field>
        <field name="prefix">REC/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_account_payment_group_outbound" model="ir.sequence">
        <field name="name">Orden de pago</field>
        <field name="code">account.payment.group.outbound</field>
        <field name="prefix">OP/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
