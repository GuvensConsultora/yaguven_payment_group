<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_l10n_latam_check_rejection_wizard_form" model="ir.ui.view">
        <field name="name">l10n_latam.check.rejection.wizard.form</field>
        <field name="model">l10n_latam.check.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Cheque rechazado">
                <group>
                    <field name="check_id" invisible="1"/>
                    <field name="payment_id" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="rejection_date"/>
                    <field name="rejection_reason"/>
                </group>
                <group string="Gastos del rechazo">
                    <field name="charge_expenses"/>
                    <group invisible="not charge_expenses">
                        <field name="expense_description"/>
                        <field name="expense_amount"/>
                        <field name="expense_account_id"/>
                        <field name="expense_tax_id"/>
                    </group>
                </group>
                <footer>
                    <button string="Confirmar"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
