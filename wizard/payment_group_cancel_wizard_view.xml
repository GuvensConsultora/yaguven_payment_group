<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_group_cancel_wizard_form" model="ir.ui.view">
        <field name="name">account.payment.group.cancel.wizard.form</field>
        <field name="model">account.payment.group.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancelar recibo / orden de pago">
                <field name="payment_group_id" invisible="1"/>
                <field name="other_month" invisible="1"/>
                <field name="notice" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Cancelar el comprobante"
                            class="btn-primary" invisible="other_month"/>
                    <button name="action_confirm" type="object" string="Entendido, cancelar igual"
                            class="btn-primary" invisible="not other_month"/>
                    <button special="cancel" string="Volver"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
