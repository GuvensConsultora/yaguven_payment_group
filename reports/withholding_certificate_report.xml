<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción de reporte: certificado de retención (Anexo VIII RG 5423).
         Se imprime sobre cada line de account.payment.group.withholding,
         una hoja por retención emitida. -->
    <record id="action_report_withholding_certificate" model="ir.actions.report">
        <field name="name">Certificado de retención</field>
        <field name="model">account.payment.group.withholding</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">yaguven_payment_group.report_withholding_certificate</field>
        <field name="report_file">yaguven_payment_group.report_withholding_certificate</field>
        <field name="print_report_name">'Certificado retención - %s' % (object.name or object.id)</field>
        <field name="binding_model_id" ref="model_account_payment_group_withholding"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_withholding_certificate_document">
        <t t-call="web.external_layout">
            <t t-set="agente" t-value="o.payment_group_id.company_id"/>
            <t t-set="retenido" t-value="o.payment_group_id.partner_id.commercial_partner_id"/>

            <div class="page" style="font-family: Arial, sans-serif; font-size: 10px; color: #2c2c2c;">

                <!-- ENCABEZADO -->
                <div style="text-align: center; margin: 6px 0 10px 0;">
                    <div style="font-size: 15px; font-weight: bold; letter-spacing: 1px;">
                        CERTIFICADO DE RETENCIÓN
                    </div>
                    <div style="font-size: 11px; color: #555;">
                        <span t-esc="o.get_withholding_type_label()"/>
                    </div>
                </div>

                <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                    <tr>
                        <td style="text-align: center; padding: 3px; border: 1px solid #999; width: 50%;">
                            <strong>Nro. Certificado:</strong>
                            <span t-esc="o.name or '—'"/>
                        </td>
                        <td style="text-align: center; padding: 3px; border: 1px solid #999; width: 50%;">
                            <strong>Fecha:</strong>
                            <span t-field="o.payment_group_id.payment_date"/>
                        </td>
                    </tr>
                </table>

                <!-- AGENTE DE RETENCIÓN -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                    <tr>
                        <td colspan="2" style="background: #d6d8db; padding: 3px 6px; font-weight: bold; border: 1px solid #999;">
                            AGENTE DE RETENCIÓN
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Razón social:</strong> <span t-field="agente.name"/>
                        </td>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>CUIT:</strong> <span t-field="agente.vat"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Cond. IVA:</strong>
                            <span t-field="agente.partner_id.l10n_ar_afip_responsibility_type_id"/>
                        </td>
                        <td style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Inicio actividades:</strong>
                            <span t-field="agente.l10n_ar_afip_start_date"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Domicilio:</strong>
                            <span t-field="agente.partner_id.street"/>
                            <t t-if="agente.partner_id.street2"> — <span t-field="agente.partner_id.street2"/></t>,
                            <span t-field="agente.partner_id.city"/>
                            <t t-if="agente.partner_id.state_id"> — <span t-field="agente.partner_id.state_id"/></t>
                            <t t-if="agente.partner_id.zip"> (<span t-field="agente.partner_id.zip"/>)</t>
                        </td>
                    </tr>
                </table>

                <!-- SUJETO RETENIDO -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                    <tr>
                        <td colspan="2" style="background: #d6d8db; padding: 3px 6px; font-weight: bold; border: 1px solid #999;">
                            SUJETO RETENIDO
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Razón social:</strong> <span t-field="retenido.name"/>
                        </td>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>CUIT:</strong> <span t-field="retenido.vat"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Cond. IVA:</strong>
                            <span t-field="retenido.l10n_ar_afip_responsibility_type_id"/>
                        </td>
                        <td style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Nro. IIBB:</strong>
                            <t t-if="retenido.l10n_ar_gross_income_number">
                                <span t-field="retenido.l10n_ar_gross_income_number"/>
                            </t>
                            <t t-else="">—</t>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2" style="padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Domicilio:</strong>
                            <span t-field="retenido.street"/>
                            <t t-if="retenido.street2"> — <span t-field="retenido.street2"/></t>,
                            <span t-field="retenido.city"/>
                            <t t-if="retenido.state_id"> — <span t-field="retenido.state_id"/></t>
                            <t t-if="retenido.zip"> (<span t-field="retenido.zip"/>)</t>
                        </td>
                    </tr>
                </table>

                <!-- DETALLE -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                    <tr>
                        <td colspan="2" style="background: #d6d8db; padding: 3px 6px; font-weight: bold; border: 1px solid #999;">
                            DETALLE DE LA RETENCIÓN
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Régimen:</strong>
                            <span t-esc="o.get_regimen_label()"/>
                        </td>
                        <td style="width: 50%; padding: 2px 6px; border: 1px solid #ccc;">
                            <strong>Comprobante:</strong>
                            <span t-esc="o.get_certificate_op_name()"/>
                        </td>
                    </tr>
                </table>

                <!-- LIQUIDACIÓN -->
                <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                    <tr>
                        <td colspan="3" style="background: #d6d8db; padding: 3px 6px; font-weight: bold; border: 1px solid #999;">
                            LIQUIDACIÓN
                        </td>
                    </tr>
                    <tr style="text-align: center; font-weight: bold; background: #f0f0f0;">
                        <td style="width: 33%; padding: 3px; border: 1px solid #ccc;">Base imponible</td>
                        <td style="width: 33%; padding: 3px; border: 1px solid #ccc;">Alícuota</td>
                        <td style="width: 34%; padding: 3px; border: 1px solid #ccc;">Importe retenido</td>
                    </tr>
                    <tr style="text-align: center; font-size: 12px;">
                        <td style="padding: 5px; border: 1px solid #ccc;">
                            <span t-field="o.base_amount"
                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </td>
                        <td style="padding: 5px; border: 1px solid #ccc;">
                            <span t-esc="o.get_alicuota_label()"/>
                        </td>
                        <td style="padding: 5px; border: 1px solid #ccc; font-weight: bold;">
                            <span t-field="o.amount"
                                  t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                        </td>
                    </tr>
                </table>

                <!-- COMPROBANTES QUE ORIGINAN LA RETENCIÓN -->
                <t t-set="invoices" t-value="o.get_certificate_invoices()"/>
                <t t-if="invoices">
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 6px;">
                        <tr>
                            <td colspan="4" style="background: #d6d8db; padding: 3px 6px; font-weight: bold; border: 1px solid #999;">
                                COMPROBANTES QUE ORIGINAN LA RETENCIÓN
                            </td>
                        </tr>
                        <tr style="background: #f0f0f0; text-align: center; font-size: 9px;">
                            <th style="padding: 2px; border: 1px solid #ccc;">Fecha</th>
                            <th style="padding: 2px; border: 1px solid #ccc;">Comprobante</th>
                            <th style="padding: 2px; border: 1px solid #ccc; text-align: right;">Neto</th>
                            <th style="padding: 2px; border: 1px solid #ccc; text-align: right;">Total</th>
                        </tr>
                        <t t-foreach="invoices" t-as="inv">
                            <tr style="font-size: 9px;">
                                <td style="padding: 2px 4px; border: 1px solid #ccc; text-align: center;">
                                    <span t-field="inv.invoice_date"/>
                                </td>
                                <td style="padding: 2px 4px; border: 1px solid #ccc;">
                                    <span t-field="inv.name"/>
                                </td>
                                <td style="padding: 2px 4px; border: 1px solid #ccc; text-align: right;">
                                    <span t-field="inv.amount_untaxed"
                                          t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                </td>
                                <td style="padding: 2px 4px; border: 1px solid #ccc; text-align: right;">
                                    <span t-field="inv.amount_total"
                                          t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </t>

                <!-- FIRMA -->
                <div style="margin-top: 30px; text-align: right; padding-right: 30px;">
                    <div style="display: inline-block; text-align: center; width: 220px;">
                        <div style="border-top: 1px solid #333; padding-top: 3px; margin-top: 40px; font-size: 9px;">
                            Firma y sello del agente de retención
                        </div>
                    </div>
                </div>

                <!-- PIE LEGAL -->
                <div style="margin-top: 8px; font-size: 8px; color: #888; text-align: center;">
                    Este certificado debe ser conservado por el sujeto retenido como
                    constancia de la retención practicada — Anexo VIII RG 5423 (ARCA).
                    Original para el retenido / Duplicado para el agente.
                </div>

            </div>
        </t>
    </template>

    <template id="report_withholding_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="yaguven_payment_group.report_withholding_certificate_document"/>
            </t>
        </t>
    </template>

</odoo>
