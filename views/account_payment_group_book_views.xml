<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_group_book_list" model="ir.ui.view">
        <field name="name">account.payment.group.book.list</field>
        <field name="model">account.payment.group.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_type"/>
                <field name="payment_type"/>
                <field name="sequence_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_account_payment_group_book_form" model="ir.ui.view">
        <field name="name">account.payment.group.book.form</field>
        <field name="model">account.payment.group.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="ej. Recibo X 00001"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="payment_type" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="sequence_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_payment_group_book" model="ir.actions.act_window">
        <field name="name">Talonarios de recibo / OP</field>
        <field name="res_model">account.payment.group.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Creá un talonario</p>
            <p>Cada talonario tiene su propia secuencia. Usalo para
               diferenciar recibos/órdenes de pago por punto de emisión,
               sucursal, caja, etc.</p>
        </field>
    </record>

    <menuitem id="menu_account_payment_group_book"
              name="Talonarios de recibo / OP"
              parent="account.menu_finance_configuration"
              action="action_account_payment_group_book"
              sequence="50"/>

</odoo>
