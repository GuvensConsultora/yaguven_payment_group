<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_group_form" model="ir.ui.view">
        <field name="name">account.payment.group.form</field>
        <field name="model">account.payment.group</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Confirmar"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state == 'cancel'"
                            confirm="Esto generará un asiento de reversión y desconciliará los comprobantes. ¿Continuar?"/>
                    <button name="action_print_recibo" type="object"
                            string="Imprimir" icon="fa-print" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_partner_account" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not partner_id">
                            <div class="o_stat_info">
                                <field name="partner_balance_amount"
                                       widget="monetary" class="o_stat_value"/>
                                <span class="o_stat_text">Estado de cuenta</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- Paso 1: identificación del comprobante -->
                    <group name="document_info">
                        <group>
                            <field name="partner_type" widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="state != 'draft'"
                                   invisible="context.get('default_partner_type')"/>
                            <field name="payment_type" widget="radio"
                                   options="{'horizontal': true}"
                                   readonly="state != 'draft'"
                                   invisible="context.get('default_payment_type')"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="communication" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="book_id" readonly="state != 'draft'"/>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <!-- Monitor en vivo: facturas − medios de pago − retenciones = neto. -->
                    <div style="background-color: #FAF3E7; border-radius: 8px; padding: 12px; margin-top: 8px;">
                        <p class="text-muted small mb-2">
                            🔍 <strong>Resumen en vivo</strong> — se actualiza solo a medida que tildás comprobantes y cargás medios de pago.
                        </p>
                        <group name="totals_header">
                            <group>
                                <field name="invoices_to_cancel_amount"
                                       help="Suma de los importes residuales de los comprobantes tildados a la izquierda. Es el bruto a cancelar."/>
                                <field name="payments_amount"
                                       string="− Medios de pago"
                                       help="Cash que sale del banco / caja / cheques / tarjetas. Lo que efectivamente entregás al partner."/>
                                <field name="withholdings_amount"
                                       string="− Retenciones"
                                       help="Impuestos retenidos al partner que NO salen del banco — los depositás vos al fisco."
                                       invisible="not withholdings_amount"/>
                                <field name="net_to_cancel_amount"
                                       string="= Neto a cancelar"
                                       help="Diferencia. Cuando llega a 0, el comprobante cuadra y podés confirmar."/>
                            </group>
                            <group>
                                <field name="advance_amount"
                                       help="Si querés entregar más cash que el bruto de las facturas, eso es anticipo. No genera retención."
                                       readonly="state != 'draft' or invoices_to_cancel_amount != 0"/>
                            </group>
                        </group>
                    </div>
                    <!-- Layout dos columnas: izquierda comprobantes, derecha pagos + retenciones -->
                    <div class="row mt16">
                        <div class="col-md-6 pe-md-3">
                            <div style="background-color: #FFF8E1; border-radius: 8px; padding: 12px;">
                                <h3 class="mb-2" title="Tildá las facturas que querés cancelar. Las retenciones se calculan automáticamente sobre el neto sin impuestos al pie.">
                                    📄 Comprobantes a cancelar
                                </h3>
                                <p class="text-muted small mb-2">
                                    Tildá las facturas a cancelar. Usá los botones abajo para cargar todas las pendientes del partner o limpiar la lista.
                                </p>
                                <div class="d-flex gap-2 mb-2">
                                    <button name="action_load_all_pending"
                                            type="object" string="📥 Cargar todos pendientes"
                                            class="btn btn-secondary btn-sm"
                                            help="Imputa todos los comprobantes posteados con saldo pendiente del partner."
                                            invisible="state != 'draft' or not partner_id"/>
                                    <button name="action_clear_to_pay"
                                            type="object" string="🧹 Limpiar"
                                            class="btn btn-secondary btn-sm"
                                            help="Vacía la lista de comprobantes a cancelar."
                                            invisible="state != 'draft' or not to_pay_move_line_ids"/>
                                </div>
                                <field name="to_pay_move_line_ids" nolabel="1"
                                       readonly="state != 'draft'">
                                    <list>
                                        <field name="date" string="Fecha"/>
                                        <field name="move_id" string="Comprobante"/>
                                        <field name="amount_residual" string="Residual"
                                               sum="Total"/>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="partner_id" column_invisible="1"/>
                                        <field name="company_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                        <div class="col-md-6 ps-md-3">
                            <div style="background-color: #FFF3E0; border-radius: 8px; padding: 12px;">
                                <h3 class="mb-2" title="Cargá efectivo, transferencias, cheques, tarjetas. El primer monto viene precargado con el cash neto a entregar al partner.">
                                    💳 Medios de pago
                                </h3>
                                <p class="text-muted small mb-2">
                                    Sumá los pagos hasta cubrir el cash neto. Cada nueva línea viene precargada con lo que falta.
                                </p>
                            <!-- Paso 3: cargar medios de pago -->
                            <field name="payment_ids" nolabel="1"
                                   readonly="state != 'draft'"
                                   context="{'default_partner_id': partner_id,
                                             'default_partner_type': partner_type,
                                             'default_payment_type': payment_type,
                                             'default_company_id': company_id,
                                             'default_date': payment_date,
                                             'default_amount': net_to_cancel_amount}">
                                <list>
                                    <field name="journal_id"
                                           domain="[('type', 'in', ['cash', 'bank'])]"/>
                                    <field name="payment_method_line_id"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="memo"/>
                                    <field name="state"/>
                                    <field name="move_id" column_invisible="1"/>
                                    <button name="action_open_move" type="object"
                                            icon="fa-book" string="Asiento"
                                            invisible="not move_id"/>
                                    <field name="partner_id" column_invisible="1"/>
                                    <field name="partner_type" column_invisible="1"/>
                                    <field name="payment_type" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                                <form string="Medio de pago">
                                    <header>
                                        <button name="action_open_move" type="object"
                                                string="Ver asiento contable"
                                                icon="fa-book"
                                                invisible="not move_id"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="journal_id"
                                                       domain="[('type', 'in', ['cash', 'bank'])]"/>
                                                <field name="payment_method_line_id"/>
                                                <field name="amount"/>
                                            </group>
                                            <group>
                                                <field name="memo" string="Concepto"/>
                                                <field name="date"/>
                                            </group>
                                        </group>
                                        <field name="move_id" invisible="1"/>
                                        <!-- invisibles necesarios para condiciones -->
                                        <field name="payment_method_code" invisible="1"/>
                                        <field name="is_card_journal" invisible="1"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="state" invisible="1"/>
                                        <field name="partner_id" invisible="1"/>
                                        <field name="partner_type" invisible="1"/>
                                        <field name="payment_type" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <!-- Cheques propios o cheques de tercero NUEVOS recibidos -->
                                        <notebook invisible="payment_method_code not in ('own_checks', 'new_third_party_checks') and not is_card_journal and payment_method_code not in ('in_third_party_checks', 'out_third_party_checks', 'return_third_party_checks')">
                                            <page string="Cheques"
                                                  invisible="payment_method_code not in ('own_checks', 'new_third_party_checks')">
                                                <field name="l10n_latam_new_check_ids" nolabel="1">
                                                    <list editable="bottom">
                                                        <field name="name" string="Número"/>
                                                        <field name="is_echeq" string="Echeq" optional="show"/>
                                                        <field name="is_cpd" string="CPD" optional="show"/>
                                                        <field name="bank_id"/>
                                                        <field name="issuer_vat" string="CUIT emisor"
                                                               column_invisible="parent.payment_method_code == 'own_checks'"/>
                                                        <field name="issuer_postal_code" string="C.P. emisor"
                                                               column_invisible="parent.payment_method_code == 'own_checks'"
                                                               optional="hide"/>
                                                        <field name="endorser_vat" string="CUIT endosante"
                                                               column_invisible="parent.payment_method_code == 'own_checks'"
                                                               optional="show"/>
                                                        <field name="issue_date" string="Emisión" optional="show"/>
                                                        <field name="payment_date" string="Fecha de pago"/>
                                                        <field name="at_sight" string="A la vista" optional="hide"/>
                                                        <field name="amount" sum="Total"/>
                                                        <field name="currency_id" column_invisible="1"/>
                                                    </list>
                                                </field>
                                                <field name="l10n_latam_check_warning_msg"
                                                       invisible="not l10n_latam_check_warning_msg"
                                                       readonly="1"/>
                                            </page>
                                            <page string="Cheques de cartera"
                                                  invisible="payment_method_code not in ('in_third_party_checks', 'out_third_party_checks', 'return_third_party_checks')">
                                                <field name="l10n_latam_move_check_ids" nolabel="1">
                                                    <list>
                                                        <field name="name"/>
                                                        <field name="is_echeq" optional="show"/>
                                                        <field name="is_cpd" string="CPD" optional="show"/>
                                                        <field name="bank_id"/>
                                                        <field name="issuer_vat" string="CUIT emisor"/>
                                                        <field name="issuer_postal_code" string="C.P. emisor" optional="hide"/>
                                                        <field name="endorser_vat" string="CUIT endosante" optional="show"/>
                                                        <field name="issue_date" string="Emisión" optional="show"/>
                                                        <field name="payment_date" string="Fecha de pago"/>
                                                        <field name="at_sight" string="A la vista" optional="hide"/>
                                                        <field name="amount" sum="Total"/>
                                                        <field name="currency_id" column_invisible="1"/>
                                                    </list>
                                                </field>
                                            </page>
                                            <page string="Datos de tarjeta"
                                                  invisible="not is_card_journal">
                                                <group>
                                                    <group>
                                                        <field name="card_brand"/>
                                                        <field name="card_last_digits"/>
                                                        <field name="card_voucher_number"/>
                                                    </group>
                                                    <group>
                                                        <field name="card_authorization_code"/>
                                                        <field name="card_installments"/>
                                                        <field name="card_holder_name"/>
                                                    </group>
                                                </group>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                                <div style="background-color: #FCE4EC; border-radius: 8px; padding: 12px; margin-top: 12px;">
                                    <h5 class="mb-2" title="Retenciones IIBB / Ganancias practicadas a este proveedor. Se autocalculan al imputar los comprobantes según las condiciones SIRCAR cargadas para el partner.">
                                        🧾 Retenciones
                                    </h5>
                                    <p class="text-muted small mb-2">
                                        Se calculan automáticamente al tildar comprobantes. Si el partner no tiene condiciones SIRCAR cargadas, la lista queda vacía.
                                    </p>
                                    <field name="withholding_ids" nolabel="1"
                                           readonly="state != 'draft'">
                                        <list editable="bottom">
                                            <field name="tax_id" string="Impuesto"/>
                                            <field name="name" string="Nº retención"/>
                                            <field name="base_amount" string="Base"/>
                                            <field name="amount" sum="Total"/>
                                            <button name="action_print_certificate"
                                                    type="object"
                                                    string="Certificado"
                                                    icon="fa-file-pdf-o"
                                                    invisible="parent.state != 'posted'"/>
                                            <field name="currency_id" column_invisible="1"/>
                                            <field name="company_id" column_invisible="1"/>
                                            <field name="partner_type" column_invisible="1"/>
                                        </list>
                                    </field>
                                </div>
                            </div>
                        </div>
                    </div>
                    <group string="Líneas conciliadas"
                           invisible="state != 'posted'">
                        <field name="matched_move_line_ids" readonly="1"
                               nolabel="1" colspan="2">
                            <list>
                                <field name="date"/>
                                <field name="move_id"/>
                                <field name="account_id"/>
                                <field name="debit"/>
                                <field name="credit"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_account_payment_group_list" model="ir.ui.view">
        <field name="name">account.payment.group.list</field>
        <field name="model">account.payment.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="book_id" optional="show"/>
                <field name="communication" optional="show"/>
                <field name="payments_amount" sum="Total" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'posted'"
                       decoration-muted="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_account_payment_group_search" model="ir.ui.view">
        <field name="name">account.payment.group.search</field>
        <field name="model">account.payment.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="book_id"/>
                <field name="communication"/>
                <filter name="draft" string="Borradores"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="posted" string="Confirmados"
                        domain="[('state', '=', 'posted')]"/>
                <filter name="cancel" string="Cancelados"
                        domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="customer" string="Clientes"
                        domain="[('partner_type', '=', 'customer')]"/>
                <filter name="supplier" string="Proveedores"
                        domain="[('partner_type', '=', 'supplier')]"/>
                <separator/>
                <filter name="group_partner" string="Tercero"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_book" string="Talonario"
                        context="{'group_by': 'book_id'}"/>
                <filter name="group_date" string="Fecha"
                        context="{'group_by': 'payment_date'}"/>
                <filter name="group_state" string="Estado"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_account_payment_group_customer" model="ir.actions.act_window">
        <field name="name">Recibos</field>
        <field name="res_model">account.payment.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'customer'), ('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_partner_type': 'customer', 'default_payment_type': 'inbound'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registrá el primer recibo de cobro</p>
            <p>Agrupá varios medios de pago (efectivo, cheque, transferencia, retenciones sufridas) en un único recibo que cancele una o más facturas del cliente.</p>
        </field>
    </record>

    <record id="action_account_payment_group_supplier" model="ir.actions.act_window">
        <field name="name">Órdenes de pago</field>
        <field name="res_model">account.payment.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('partner_type', '=', 'supplier'), ('payment_type', '=', 'outbound')]</field>
        <field name="context">{'default_partner_type': 'supplier', 'default_payment_type': 'outbound'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Registrá la primera orden de pago</p>
            <p>Agrupá varios medios de pago (efectivo, cheque propio, transferencia, retenciones practicadas) en una única OP que cancele una o más facturas del proveedor.</p>
        </field>
    </record>

</odoo>
