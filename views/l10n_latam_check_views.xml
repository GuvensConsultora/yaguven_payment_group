<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Picker de cheques: agrega CUIT del emisor y banco como columnas.
         La vista base `view_account_own_check_tree` es la que cae por
         defecto cuando se abre un many2many de l10n_latam.check (y la
         primaria `view_account_third_party_check_tree` la hereda). -->
    <record id="view_account_own_check_tree_with_issuer_bank" model="ir.ui.view">
        <field name="name">l10n_latam.check.list.yaguven</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_own_check_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="is_echeq" optional="show"/>
                <field name="is_cpd" string="CPD" optional="show"/>
                <field name="bank_id" optional="show"/>
                <field name="issuer_vat" string="CUIT emisor" optional="show"/>
                <field name="issuer_postal_code" string="C.P. emisor" optional="hide"/>
                <field name="endorser_vat" string="CUIT endosante" optional="show"/>
                <field name="issue_date" string="Emisión" optional="show"/>
                <field name="at_sight" string="A la vista" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
