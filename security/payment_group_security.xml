<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_group_comp_rule" model="ir.rule">
        <field name="name">Payment Group multi-company</field>
        <field name="model_id" ref="model_account_payment_group"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>

    <record id="payment_group_book_comp_rule" model="ir.rule">
        <field name="name">Payment Group Book multi-company</field>
        <field name="model_id" ref="model_account_payment_group_book"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>

    <record id="payment_group_withholding_comp_rule" model="ir.rule">
        <field name="name">Payment Group Withholding multi-company</field>
        <field name="model_id" ref="model_account_payment_group_withholding"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>

</odoo>
